# Copie para .env e preencha. Nunca versione o .env com valores reais.

# Postgres do app (Supabase). Sem esta variável (comentada), o servidor usa o PGLite
# local em .data/pglite.
# DATABASE_URL=postgres://USUARIO:SENHA@HOST:5432/BANCO

# Segredo do fechamento diário das noites (Vercel Cron). A Vercel envia
# "Authorization: Bearer <CRON_SECRET>" para /api/cron/fechar-noites. Use um valor
# aleatório longo; sem esta variável, a rota recusa todas as chamadas.
# CRON_SECRET=SEU_SEGREDO_AQUI

# Chave da equipe: protege as rotas da equipe, como /api/equipe/metricas, que recebe
# "Authorization: Bearer <NUXT_CHAVE_DA_EQUIPE>". Use um valor aleatório longo; sem
# esta variável, as rotas da equipe recusam todas as chamadas.
# NUXT_CHAVE_DA_EQUIPE=SUA_CHAVE_AQUI
